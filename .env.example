POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=jungle_gaming
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Bloco 9a.3 — porta do LocalStack (fundacao SQS). Nenhuma credencial real
# aqui: as credenciais AWS usadas pelo servico localstack-init do
# docker-compose.yml sao valores fixos ficticios ("test"), nunca lidos deste
# arquivo.
LOCALSTACK_PORT=4566

# Bloco 9b.2 — consumidor SQS real. Credenciais ficticias, validas so contra
# o LocalStack (nao verifica assinatura). SQS_ENDPOINT_URL e localhost aqui
# porque a aplicacao ainda roda no host, nao dentro do Compose — se um dia
# ela for containerizada, so este valor muda para http://localstack:4566.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT_URL=http://localhost:4566
WAGER_TRANSACTIONS_CONSUMER_ENABLED=true
