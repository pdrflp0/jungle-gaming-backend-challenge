      "checks": [
        {
          "name": "wager_transactions_amount_positive",
          "columnName": "amount",
          "definition": "CHECK ((amount > (0)::numeric))",
          "expression": "amount > 0"
        },
        {
          "name": "wager_transactions_attempts_non_negative",
          "columnName": "attempts",
          "definition": "CHECK ((attempts >= 0))",
          "expression": "attempts >= 0"
        },
        {
          "name": "wager_transactions_currency_format",
          "columnName": "currency",
          "definition": "CHECK (((currency)::text ~ '^[A-Z]{3}$'::text))",
          "expression": "currency ~ '^[A-Z]{3}$'::text"
        },
        {
          "name": "wager_transactions_failure_code_consistency",
          "columnName": "status",
          "definition": "CHECK (((((status)::text = ANY ((ARRAY['REJECTED'::character varying, 'FAILED'::character varying])::text[])) AND (failure_code IS NOT NULL)) OR (((status)::text <> ALL ((ARRAY['REJECTED'::character varying, 'FAILED'::character varying])::text[])) AND (failure_code IS NULL))))",
          "expression": "((status = ANY (ARRAY['REJECTED'::character varying, 'FAILED'::character varying][])) AND failure_code IS NOT NULL)) OR (((status <> ALL (ARRAY['REJECTED'::character varying, 'FAILED'::character varying][])) AND (failure_code IS NULL))"
        },
        {
          "name": "wager_transactions_next_attempt_consistency",
          "columnName": "status",
          "definition": "CHECK (((((status)::text = 'PENDING_REFERENCE'::text) AND (next_attempt_at IS NOT NULL)) OR (((status)::text <> 'PENDING_REFERENCE'::text) AND (next_attempt_at IS NULL))))",
          "expression": "((status = 'PENDING_REFERENCE'::text) AND next_attempt_at IS NOT NULL)) OR (((status <> 'PENDING_REFERENCE'::text) AND (next_attempt_at IS NULL))"
        },
        {
          "name": "wager_transactions_processed_at_consistency",
          "columnName": "status",
          "definition": "CHECK (((((status)::text = 'PROCESSED'::text) AND (processed_at IS NOT NULL)) OR (((status)::text <> 'PROCESSED'::text) AND (processed_at IS NULL))))",
          "expression": "((status = 'PROCESSED'::text) AND processed_at IS NOT NULL)) OR (((status <> 'PROCESSED'::text) AND (processed_at IS NULL))"
        },
        {
          "name": "wager_transactions_reference_required_on_create",
          "columnName": "kind",
          "definition": "CHECK ((((kind)::text <> ALL ((ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying])::text[])) OR (reference_external_transaction_id IS NOT NULL)))",
          "expression": "(kind <> ALL (ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying][])) OR (reference_external_transaction_id IS NOT NULL)"
        },
        {
          "name": "wager_transactions_reference_required_when_processed",
          "columnName": "status",
          "definition": "CHECK ((((kind)::text <> ALL ((ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying])::text[])) OR ((status)::text <> 'PROCESSED'::text) OR (reference_transaction_id IS NOT NULL)))",
          "expression": "(kind <> ALL (ARRAY['REFUND'::character varying, 'ROLLBACK'::character varying][])) OR (status <> 'PROCESSED'::text) OR (reference_transaction_id IS NOT NULL)"
        },
        {
          "name": "wager_transactions_result_balance_both_or_neither",
          "columnName": "result_balance_currency",
          "definition": "CHECK ((((result_balance_amount IS NULL) AND (result_balance_currency IS NULL)) OR ((result_balance_amount IS NOT NULL) AND (result_balance_currency IS NOT NULL))))",
          "expression": "((result_balance_amount IS NULL) AND (result_balance_currency IS NULL)) OR ((result_balance_amount IS NOT NULL) AND (result_balance_currency IS NOT NULL))"
        },
        {
          "name": "wager_transactions_result_balance_currency_format",
          "columnName": "result_balance_currency",
          "definition": "CHECK (((result_balance_currency IS NULL) OR ((result_balance_currency)::text ~ '^[A-Z]{3}$'::text)))",
          "expression": "result_balance_currency IS NULL) OR ((result_balance_currency ~ '^[A-Z]{3}$'::text)"
        },
        {
          "name": "wager_transactions_result_balance_non_negative",
          "columnName": "result_balance_amount",
          "definition": "CHECK (((result_balance_amount IS NULL) OR (result_balance_amount >= (0)::numeric)))",
          "expression": "result_balance_amount IS NULL) OR (result_balance_amount >= (0)"
        }
