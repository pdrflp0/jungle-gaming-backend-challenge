{
  "name": "jungle-gaming-backend-challenge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:verify": "bun run scripts/verify-database.ts",
    "test:integration": "bun test ./src/wallets/open-wallet.integration.ts ./src/wagering/process-bet.integration.ts ./src/wagering/wagering.integration.ts ./src/wagering/retry-pending-reference.integration.ts",
    "test:concurrency": "bun test ./src/wagering/process-bet.concurrency.ts ./src/wagering/idempotency.concurrency.ts ./src/wagering/reference-reuse.concurrency.ts ./src/wagering/retry-pending-reference.concurrency.ts",
    "migration:up": "mikro-orm migration:up",
    "migration:down": "mikro-orm migration:down"
  },
  "dependencies": {
    "@mikro-orm/core": "6.6.16",
    "@mikro-orm/migrations": "6.6.16",
    "@mikro-orm/nestjs": "6.1.2",
    "@mikro-orm/postgresql": "6.6.16",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.4.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@mikro-orm/cli": "6.6.16",
    "@nestjs/testing": "^10.4.0",
    "@types/bun": "^1.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "knex": "3.2.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
